			"content:wysiwyg_basic:7:63": {
				"icon": "outdent",
				"name": "WYSIWYG",
				"type": "wysiwyg_basic",
				"html": "<ul>\n\t<li>A gift in your Will (often referred to as a bequest)</li>\n\t<li>Charitable trust</li>\n\t<li>Gift of real estate</li>\n\t<li>Charitable Gift Annuity</li>\n\t<li><a href=\"https://bnymelloncharitablegiftfund.org/salvationarmy/\" target=\"\">Donor-Advised Fund</a></li>\n\t<li>Cryptocurrency</li>\n\t<li>Endowment</li>\n\t<li>Qualified Charitable Distribution from an IRA</li>\n\t<li>Beneficiary designation in a life insurance policy, a retirement account, or a bank or investment account</li>\n</ul>",
				"description": "Text with HTML references.",
				"draggable": true,
				"content": "<ul>\n\t<li>A gift in your Will (often referred to as a bequest)</li>\n\t<li>Charitable trust</li>\n\t<li>Gift of real estate</li>\n\t<li>Charitable Gift Annuity</li>\n\t<li><a href=\"https://bnymelloncharitablegiftfund.org/salvationarmy/\" target=\"\">Donor-Advised Fund</a></li>\n\t<li>Cryptocurrency</li>\n\t<li>Endowment</li>\n\t<li>Qualified Charitable Distribution from an IRA</li>\n\t<li>Beneficiary designation in a life insurance policy, a retirement account, or a bank or investment account</li>\n</ul>",
				"position": 8,
				"fullName": "content:wysiwyg_basic:7:63",
				"htmlElement": "html",
				"primarytype": "content",
				"id": "content:wysiwyg_basic:7:63",
