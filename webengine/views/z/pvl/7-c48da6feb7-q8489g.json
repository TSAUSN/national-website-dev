			"content:textarea:4:0": {
				"icon": "align-justify",
				"name": "Paragraph",
				"type": "textarea",
				"html": "<p>\n\tThank you for considering supporting the future work of The Salvation Army through the impact of your charitable legacy. We are pleased to offer you opportunities to realize the value of your estate for yourself, your family, and your community by supporting the causes that matter most to you.\n</p>",
				"description": "Mixed Plain and Rich Text",
				"draggable": true,
				"content": "Thank you for considering supporting the future work of The Salvation Army through the impact of your charitable legacy. We are pleased to offer you opportunities to realize the value of your estate for yourself, your family, and your community by supporting the causes that matter most to you.",
				"position": 5,
				"fullName": "content:textarea:4:0",
				"htmlElement": "p",
				"primarytype": "content",
				"id": "content:textarea:4:0",
				"styles": {},
				"newLoc": "layout:root:column:0",
				"oldLoc": "bank",
				"contentOverride": false
			},
			"content:textarea:5:55": {
				"icon": "align-justify",
				"name": "Paragraph",
				"type": "textarea",
				"html": "<p>\n\tWe would enjoy hearing of the human needs that you feel most passionate about, and how we can partner together to help alleviate those needs. As we learn more about your interests and your situation, we can help you determine the best ways for you to give that will help meet the needs that are most concerning to you.&nbsp;Your planned gift can also benefit you in the form of lifetime income, tax deductions and in other ways.\n</p>",
				"description": "Mixed Plain and Rich Text",
				"draggable": true,
				"content": "We would enjoy hearing of the human needs that you feel most passionate about, and how we can partner together to help alleviate those needs. As we learn more about your interests and your situation, we can help you determine the best ways for you to give that will help meet the needs that are most concerning to you.&nbsp;Your planned gift can also benefit you in the form of lifetime income, tax deductions and in other ways.",
				"position": 6,
				"fullName": "content:textarea:5:55",
				"htmlElement": "p",
				"primarytype": "content",
				"id": "content:textarea:5:55",
				"styles": {},
				"newLoc": "layout:root:column:0",
				"oldLoc": "bank",
				"contentOverride": false
			},
			"content:textarea:6:19": {
				"icon": "align-justify",
				"name": "Paragraph",
				"type": "textarea",
				"html": "<p>\n\tThere are many popular giving options for you to choose from, such as:\n</p>",
				"description": "Mixed Plain and Rich Text",
				"draggable": true,
				"content": "There are many popular giving options for you to choose from, such as:",
