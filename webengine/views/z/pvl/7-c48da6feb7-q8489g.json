			"content:wysiwyg_basic:8:59": {
				"icon": "outdent",
				"name": "WYSIWYG",
				"type": "wysiwyg_basic",
				"html": "<p>\n\tA Charitable Gift Annuity, backed by The Salvation Army, can be a compelling means of giving that benefits you by providing lifetime income to you. If you would like to receive an illustration of how a gift annuity could work for you, please contact us below. If you would like to gain a greater understanding of how Planned Giving can help you achieve your charitable intentions, please&nbsp;<a href=\"https://www.tsalegacyoflove.org/\" target=\"\">click here</a>&nbsp;to view our Planned Giving site which has more information about the giving options listed above.\n</p>",
				"description": "Text with HTML references.",
				"draggable": true,
				"content": "<p>\n\tA Charitable Gift Annuity, backed by The Salvation Army, can be a compelling means of giving that benefits you by providing lifetime income to you. If you would like to receive an illustration of how a gift annuity could work for you, please contact us below. If you would like to gain a greater understanding of how Planned Giving can help you achieve your charitable intentions, please&nbsp;<a href=\"https://www.tsalegacyoflove.org/\" target=\"\">click here</a>&nbsp;to view our Planned Giving site which has more information about the giving options listed above.\n</p>",
				"position": 9,
				"fullName": "content:wysiwyg_basic:8:59",
				"htmlElement": "html",
				"primarytype": "content",
				"id": "content:wysiwyg_basic:8:59",
				"styles": {},
				"newLoc": "layout:root:column:0",
				"oldLoc": "bank",
				"contentOverride": false
			},
			"content:textarea:9:69": {
				"icon": "align-justify",
				"name": "Paragraph",
				"type": "textarea",
				"html": "<p>\n\tThank you again for supporting The Salvation Army's mission to meet human needs in His name, without discrimination. Please contact us if you would like to explore the charitable planning options available to you. We are glad to have a conversation with you and provide helpful planning resources.\n</p>",
				"description": "Mixed Plain and Rich Text",
				"draggable": true,
				"content": "Thank you again for supporting The Salvation Army's mission to meet human needs in His name, without discrimination. Please contact us if you would like to explore the charitable planning options available to you. We are glad to have a conversation with you and provide helpful planning resources.",
