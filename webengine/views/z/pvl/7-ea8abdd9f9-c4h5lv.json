							"content:textarea:8:34": {
								"icon": "align-justify",
								"name": "Paragraph",
								"type": "textarea",
								"html": "<p>\n\tThe items that you donate are added to our shelves and clothing racks. Our stores are frequented by so many different people – some looking for their own unique fashion sense, some looking for a deal,&nbsp;some because they have nowhere else to go.\n</p>",
								"description": "Mixed Plain and Rich Text",
								"draggable": true,
								"content": "The items that you donate are added to our shelves and clothing racks. Our stores are frequented by so many different people – some looking for their own unique fashion sense, some looking for a deal,&nbsp;some because they have nowhere else to go.",
								"position": 7,
								"fullName": "content:textarea:8:34",
