							"content:wysiwyg_basic:3:30": {
								"icon": "outdent",
								"name": "WYSIWYG",
								"type": "wysiwyg_basic",
								"html": "<ul>\n\t<li>When you&nbsp;donate goods, you're helping to provide items that are sold to the community or given to those with the greatest need.</li>\n\t<li>When you&nbsp;shop for items&nbsp;at our stores, you're directly funding the life-restoring programs that exist in your community.</li>\n</ul>",
								"description": "Text with HTML references.",
								"draggable": true,
								"content": "<ul>\n\t<li>When you&nbsp;donate goods, you're helping to provide items that are sold to the community or given to those with the greatest need.</li>\n\t<li>When you&nbsp;shop for items&nbsp;at our stores, you're directly funding the life-restoring programs that exist in your community.</li>\n</ul>",
								"model": "6",
								"position": 2,
								"fullName": "content:wysiwyg_basic:3:30",
