							},
							"content:textarea:9:80": {
								"icon": "align-justify",
								"name": "Paragraph",
								"type": "textarea",
								"html": "<p>Whether they're purchased by a college student adding to their wardrobe or by a family struggling to make ends meet,&nbsp;these sales directly fund local, life-giving programs&nbsp;provided by The Salvation Army.&nbsp;</p>",
								"description": "Mixed Plain and Rich Text",
								"draggable": true,
								"content": "Whether they're purchased by a college student adding to their wardrobe or by a family struggling to make ends meet,&nbsp;these sales directly fund local, life-giving programs&nbsp;provided by The Salvation Army.&nbsp;",
