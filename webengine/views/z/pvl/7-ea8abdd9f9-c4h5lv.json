							"content:textarea:2:78": {
								"icon": "align-justify",
								"name": "Paragraph",
								"type": "textarea",
								"html": "<p>\n\tThe Salvation Army&nbsp;of the Midlands Thrift Stores helps the community in a couple of very important ways:\n</p>",
								"description": "Mixed Plain and Rich Text",
								"draggable": true,
								"content": "The Salvation Army&nbsp;of the Midlands Thrift Stores helps the community in a couple of very important ways:",
								"position": 1,
								"fullName": "content:textarea:2:78",
								"htmlElement": "p",
								"primarytype": "content",
								"id": "content:textarea:2:78",
