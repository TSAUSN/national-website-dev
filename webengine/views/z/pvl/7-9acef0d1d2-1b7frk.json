								"name": "WYSIWYG",
								"type": "wysiwyg_basic",
								"html": "<ul>\n\t<li>Living in motels/hotels</li>\n\t<li>Doubled up -sharing a home with another family due to economic hardship or loss of housing</li>\n\t<li>Living in a shelter</li>\n\t<li>Living in cars/parks/campgrounds/abandoned building</li>\n\t<li>Living under bridges, bus stations</li>\n\t<li>Unaccompanied homeless youth<br>\n\t&nbsp;</li>\n</ul>",
