							"content:wysiwyg_basic:6:26": {
								"icon": "outdent",
								"name": "WYSIWYG",
								"type": "wysiwyg_basic",
								"html": "<div style=\"position:relative;overflow:hidden;min-height:300px;background-image:url('https://s3.amazonaws.com/uss-cache.salvationarmy.org/ba1ae43a-1116-430b-a313-47c06d536cc0_Blue+BG.png');background-position:center center;background-repeat:no-repeat;background-size:cover;\" class=\"text-white rounded p-6 gap-3 my-5\">\n            <div style=\"position:absolute;inset:0;z-index:2;\"></div>\n            <div style=\"position:relative;z-index:3;display:flex;align-items:center;justify-content:flex-start;min-height:300px;\">\n                <div style=\"width:100%;padding:40px;color:#ffffff;\">\n                    <h5 style=\"text-align:center;\">How We Help Cure Hunger</h5>\n\n<p style=\"text-align:center;color:#fff;\">\n\tThe Salvation Army Greater Birmingham Area Command hosts food pantries in three areas to combat hunger and food insecurity in our area. By supplying free fresh produce, canned goods, and healthy frozen items, our food pantries provide valuable meal supplementation while helping those in need maintain their independence and dignity. These food pantries are especially crucial in “food deserts,” where entire communities experience food insecurity due to a lack of grocery store access.\n</p>\n                </div>\n            </div>\n        </div>",
								"description": "Text with HTML references.",
