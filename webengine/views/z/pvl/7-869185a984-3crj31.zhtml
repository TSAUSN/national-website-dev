<div className={styles.pvlRoot}>
	<div class="py-5" data-zesty-id="design:design:whitespace-xl:74:97"></div>
	<h5 class="u-standardCase" data-zesty-id="content:text:1:82">Donate Money</h5>
	<p class="margin-bottom-xl padding-bottom-lg" data-zesty-id="content:textarea:2:40">
						Your donations&nbsp;help us serve the most vulnerable members of our community. Please choose the program you would like to donate to below. Thank you for helping The Salvation Army do the most good!
					</p>
	<p data-zesty-id="content:wysiwyg_basic:3:43">
						<a href="https://give.salvationarmycarolinas.org/give/175533/#!/donation/checkout"><span class="btn btn-solid btn-red">Greenville County</span></a>&nbsp;<a href="https://give.salvationarmycarolinas.org/give/364784/#!/donation/checkout"><span class="btn btn-solid btn-red">Pickens County</span></a>&nbsp;<span class="btn btn-solid btn-red"><a href="https://give.salvationarmycarolinas.org/give/364745/#!/donation/checkout" target="">Oconee Count</a>y</span>
					</p>
	<div class="my-2" data-zesty-id="design:design:whitespace-sm:4:94"></div>
	<p data-zesty-id="content:wysiwyg_basic:5:11">
