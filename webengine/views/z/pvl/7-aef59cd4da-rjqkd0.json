								"name": "WYSIWYG",
								"type": "wysiwyg_basic",
								"html": "<div style=\"position:relative;overflow:hidden;min-height:520px;background-image:url('https://s3.amazonaws.com/uss-cache.salvationarmy.org/d66aa8be-9105-4e58-b95b-3484d0e03f67_Blue+BG.png');background-position:center center;background-repeat:repeat;background-size:cover;\" class=\"text-white\">\n            <div style=\"position:absolute;inset:0;z-index:2;\"></div>\n            <div style=\"position:relative;z-index:3;display:flex;align-items:center;justify-content:flex-start;min-height:520px;\">\n                <div style=\"width:100%;padding:40px;color:#ffffff;\">\n                    <div class=\"btgrid\">\n\t<div class=\"row row-1\">\n\t\t<div class=\"col col-md-2 col-sm-12\">\n\t\t\t<div class=\"content\">\n\t\t\t\t\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"col col-md-8 col-sm-12\">\n\t\t\t<div class=\"content\">\n\t\t\t\t<h6 style=\"text-align:center;\">MISSION STATEMENT</h6>\n\n\t\t\t\t<p style=\"text-align:center;color:#fff;\">\n\t\t\t\t\tThe Salvation Army, an international movement, is an evangelical part of the universal Christian church. Its message is based on the Bible. Its ministry is motivated by the love of God. Its mission is to preach the Gospel of Jesus Christ and to meet human needs in His name without discrimination.\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"col col-md-2 col-sm-12\">\n\t\t\t<div class=\"content\">\n\t\t\t\t\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>\n                </div>\n            </div>\n        </div>",
								"description": "Text with HTML references.",
								"draggable": true,
								"content": "<div style=\"position:relative;overflow:hidden;min-height:520px;background-image:url('https://s3.amazonaws.com/uss-cache.salvationarmy.org/d66aa8be-9105-4e58-b95b-3484d0e03f67_Blue+BG.png');background-position:center center;background-repeat:repeat;background-size:cover;\">\n            <div style=\"position:absolute;inset:0;z-index:2;\"></div>\n            <div style=\"position:relative;z-index:3;display:flex;align-items:center;justify-content:flex-start;min-height:520px;\">\n                <div style=\"width:100%;padding:40px;color:#ffffff;\">\n                    <div class=\"btgrid\">\n\t<div class=\"row row-1\">\n\t\t<div class=\"col col-md-2 col-sm-12\">\n\t\t\t<div class=\"content\">\n\t\t\t\t\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"col col-md-8 col-sm-12\">\n\t\t\t<div class=\"content\">\n\t\t\t\t<h6 style=\"text-align:center;\">MISSION STATEMENT</h6>\n\n\t\t\t\t<p style=\"text-align:center;color:#fff;\">\n\t\t\t\t\tThe Salvation Army, an international movement, is an evangelical part of the universal Christian church. Its message is based on the Bible. Its ministry is motivated by the love of God. Its mission is to preach the Gospel of Jesus Christ and to meet human needs in His name without discrimination.\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"col col-md-2 col-sm-12\">\n\t\t\t<div class=\"content\">\n\t\t\t\t\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>\n                </div>\n            </div>\n        </div>",
