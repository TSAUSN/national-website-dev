							"content:wysiwyg_basic:4:51": {
								"icon": "outdent",
								"name": "WYSIWYG",
								"type": "wysiwyg_basic",
								"html": "<ul>\n\t<li>Call <a href=\"tel:919-834-6733&nbsp;\" target=\"\">919-834-6733</a>&nbsp;on Friday at 8 am to&nbsp;schedule an&nbsp;appointment for Monday. Appointments on Monday are between 9 am and noon.</li>\n\t<li>Appointments can be made up to one&nbsp;week in advance.</li>\n\t<li>Vouchers are $30 per individual April - September and $35 October - March and can only be used&nbsp;to shop in our Family Store.</li>\n\t<li>Clothing assistance can be given every six months.</li>\n\t<li>From October through February, free coats are available to those receiving vouchers.</li>\n</ul>",
								"description": "Text with HTML references.",
								"draggable": true,
								"content": "<ul>\n\t<li>Call <a href=\"tel:919-834-6733&nbsp;\" target=\"\">919-834-6733</a>&nbsp;on Friday at 8 am to&nbsp;schedule an&nbsp;appointment for Monday. Appointments on Monday are between 9 am and noon.</li>\n\t<li>Appointments can be made up to one&nbsp;week in advance.</li>\n\t<li>Vouchers are $30 per individual April - September and $35 October - March and can only be used&nbsp;to shop in our Family Store.</li>\n\t<li>Clothing assistance can be given every six months.</li>\n\t<li>From October through February, free coats are available to those receiving vouchers.</li>\n</ul>",
