											"content:wysiwyg_basic:16:38": {
												"icon": "outdent",
												"name": "WYSIWYG",
												"type": "wysiwyg_basic",
												"html": "<ul>\n\t\t\t\t<li>No Weapons</li>\n\t\t\t\t<li>No Alcohol</li>\n\t\t\t\t<li>No Drugs</li>\n\t\t\t\t<li>No Profanity or Slurs</li>\n\t\t\t\t<li>No Bullying</li>\n\t\t\t\t<li>No Food or Drink Allowed in the sleeping area</li>\n\t\t\t\t<li>No Sexual Acting out</li>\n\t\t\t\t<li>Be respectful of yourself and others</li>\n\t\t\t\t<li>Leave bad or quarrelsome attitudes off tsa property</li>\n\t\t\t\t<li>Everyone entering consents to a Breathalyzer test and searches of their bags and person</li>\n\t\t\t\t<li>Smoking is only allowed Outside – Use Ash Cans</li>\n\t\t\t\t<li>During these times: 6 to 10 pm and 6 to 7 am</li>\n\t\t\t\t<li>Smoking is not allowed during lights out.</li>\n\t\t\t\t<li>Stay outside the door – Loitering around the building is not acceptable</li>\n\t\t\t</ul>",
												"description": "Text with HTML references.",
												"draggable": true,
												"content": "<ul>\n\t\t\t\t<li>No Weapons</li>\n\t\t\t\t<li>No Alcohol</li>\n\t\t\t\t<li>No Drugs</li>\n\t\t\t\t<li>No Profanity or Slurs</li>\n\t\t\t\t<li>No Bullying</li>\n\t\t\t\t<li>No Food or Drink Allowed in the sleeping area</li>\n\t\t\t\t<li>No Sexual Acting out</li>\n\t\t\t\t<li>Be respectful of yourself and others</li>\n\t\t\t\t<li>Leave bad or quarrelsome attitudes off tsa property</li>\n\t\t\t\t<li>Everyone entering consents to a Breathalyzer test and searches of their bags and person</li>\n\t\t\t\t<li>Smoking is only allowed Outside – Use Ash Cans</li>\n\t\t\t\t<li>During these times: 6 to 10 pm and 6 to 7 am</li>\n\t\t\t\t<li>Smoking is not allowed during lights out.</li>\n\t\t\t\t<li>Stay outside the door – Loitering around the building is not acceptable</li>\n\t\t\t</ul>",
