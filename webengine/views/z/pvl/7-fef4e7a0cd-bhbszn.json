							"content:textarea:16:33": {
								"icon": "align-justify",
								"name": "Paragraph",
								"type": "textarea",
								"html": "<p>The Salvation Army understands the impact of unexpected life changes. Maybe you lost your job. Maybe you're a senior living on a fixed income. Maybe you're living with a long-term disability. If so, we are here for you.</p>",
