							"content:wysiwyg_basic:5:24": {
								"icon": "outdent",
								"name": "WYSIWYG",
								"type": "wysiwyg_basic",
								"html": "<div style=\"position:relative;overflow:hidden;min-height:300px;background-image:url('https://s3.amazonaws.com/uss-cache.salvationarmy.org/ba1ae43a-1116-430b-a313-47c06d536cc0_Blue+BG.png');background-position:center center;background-repeat:no-repeat;background-size:cover;\" class=\"text-white rounded p-6 gap-3 my-5\">\n            <div style=\"position:absolute;inset:0;z-index:2;\"></div>\n            <div style=\"position:relative;z-index:3;display:flex;align-items:center;justify-content:flex-start;min-height:300px;\">\n                <div style=\"width:100%;padding:40px;color:#ffffff;\">\n                    <h5 style=\"text-align:center;\">How we help overcome poverty</h5>\n\n<p style=\"text-align:center;color:#fff;\">\n\tEach night in the United States, 17.4 million families go to bed hungry.<br>\n\tAn additional 6.9 million families live on the verge of food insecurity.<br>\n\tThat means they don’t always know where their next meal is coming from.\n</p>\n                </div>\n            </div>\n        </div>",
