							"content:wysiwyg_basic:6:94": {
								"icon": "outdent",
								"name": "WYSIWYG",
								"type": "wysiwyg_basic",
								"html": "<div style=\"position:relative;overflow:hidden;min-height:300px;background-image:url('https://s3.amazonaws.com/uss-cache.salvationarmy.org/ba1ae43a-1116-430b-a313-47c06d536cc0_Blue+BG.png');background-position:center center;background-repeat:no-repeat;background-size:cover;\" class=\"text-white rounded p-6 gap-3 my-5\">\n            <div style=\"position:absolute;inset:0;z-index:2;\"></div>\n            <div style=\"position:relative;z-index:3;display:flex;align-items:center;justify-content:flex-start;min-height:300px;\">\n                <div style=\"width:100%;padding:40px;color:#ffffff;\">\n                    <p style=\"color:#fff\">\n\t<strong>Emergency Housing&nbsp;Programs</strong>\n</p>\n\n<p style=\"color:#fff\">\n\tThe Salvation Army of Greater Birmingham is the only shelter in Central Alabama, serving men, women, children, families, and veterans at one location, The Center of Hope. We offer emergency services that include&nbsp;food, shelter, clothing, and counseling. If you are experiencing homelessness, and need immediate help, please call&nbsp;<a href=\"tel:2053282420\">205-328-2420</a>&nbsp;or come to The Salvation Army Social Services Building, located at 2015 26th Avenue North Birmingham, AL 35234, for assistance.\n</p>\n                </div>\n            </div>\n        </div>",
