							"content:wysiwyg_basic:6:36": {
								"icon": "outdent",
								"name": "WYSIWYG",
								"type": "wysiwyg_basic",
								"html": "<div style=\"color:#111111;\" class=\"rounded p-6 gap-3 mt-3 bg-light text-dark\"><h5>Together, We Can Do the <span style=\"color:#ed1c2b;\">Most Good</span></h5>\n\n<p>\n\tWe are excited to offer exclusive partnership and sponsorship opportunities for businesses and organizations looking to make a meaningful impact.\n</p>\n\n<p>\n\tBy aligning with us, you can showcase your brand to a diverse and engaged audience while supporting <strong>The Salvation Army's mission of Doing The Most Good.</strong>\n</p>\n\n<p>\n\tAs a partner or sponsor, you’ll gain visibility and recognition through a range of branding opportunities, including logo placement, media exposure, event signage and customized activations. Whether you're looking to increase brand awareness, connect with potential customers or demonstrate your commitment to helping those in need, our annual or event-specific packages ensure maximum exposure and meaningful engagement.\n</p>\n\n<p>\n\tJoin us in creating a lasting impression and making a difference. Together, we can achieve great things!\n</p>\n\n<p>\n\tView our <a href=\"https://s3.amazonaws.com/uss-cache.salvationarmy.org/f05b863d-a268-47c2-92ea-a07d659b369a_Sig+Events+Updated+Aug+2025.pdf\">Signature Events&nbsp;Flyer</a>.\n</p>\n\n<div class=\"btgrid\">\n\t<div class=\"row row-1\">\n\t\t<div class=\"col col-md-6\">\n\t\t\t<div class=\"content\">\n\t\t\t\t<p style=\"text-align:center;\">\n\t\t\t\t\t<strong><a href=\"https://s3.amazonaws.com/uss-cache.salvationarmy.org/aa791d95-c122-4d3b-b380-2b3b6a0057c0_2026+Sponsor+Levels+and+Benefits.pdf\" class=\"btn btn-secondary gap-1 mt-2\">Partnership Options</a></strong>\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"col col-md-6\">\n\t\t\t<div class=\"content\">\n\t\t\t\t<p style=\"text-align:center;\" class=\"cta-button-group d-flex flex-wrap gap-2 my-3 justify-content-center\"><a href=\"mailto:lionel.bacon@uss.salvationarmy.org\" class=\"btn btn-secondary gap-1 mt-2\">Interested? Email Us.</a></p>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>\n\n<p>\n\t \n</p></div>",
								"content": "<div style=\"color:#111111;\" class=\"rounded p-6 gap-3 mt-3 bg-light text-dark\"><h5>Together, We Can Do the <span style=\"color:#ed1c2b;\">Most Good</span></h5>\n\n<p>\n\tWe are excited to offer exclusive partnership and sponsorship opportunities for businesses and organizations looking to make a meaningful impact.\n</p>\n\n<p>\n\tBy aligning with us, you can showcase your brand to a diverse and engaged audience while supporting <strong>The Salvation Army's mission of Doing The Most Good.</strong>\n</p>\n\n<p>\n\tAs a partner or sponsor, you’ll gain visibility and recognition through a range of branding opportunities, including logo placement, media exposure, event signage and customized activations. Whether you're looking to increase brand awareness, connect with potential customers or demonstrate your commitment to helping those in need, our annual or event-specific packages ensure maximum exposure and meaningful engagement.\n</p>\n\n<p>\n\tJoin us in creating a lasting impression and making a difference. Together, we can achieve great things!\n</p>\n\n<p>\n\tView our <a href=\"https://s3.amazonaws.com/uss-cache.salvationarmy.org/f05b863d-a268-47c2-92ea-a07d659b369a_Sig+Events+Updated+Aug+2025.pdf\">Signature Events&nbsp;Flyer</a>.\n</p>\n\n<div class=\"btgrid\">\n\t<div class=\"row row-1\">\n\t\t<div class=\"col col-md-6\">\n\t\t\t<div class=\"content\">\n\t\t\t\t<p style=\"text-align:center;\">\n\t\t\t\t\t<strong><a href=\"https://s3.amazonaws.com/uss-cache.salvationarmy.org/aa791d95-c122-4d3b-b380-2b3b6a0057c0_2026+Sponsor+Levels+and+Benefits.pdf\" class=\"btn btn-secondary gap-1 mt-2\">Partnership Options</a></strong>\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"col col-md-6\">\n\t\t\t<div class=\"content\">\n\t\t\t\t<p style=\"text-align:center;\" class=\"cta-button-group d-flex flex-wrap gap-2 my-3 justify-content-center\"><a href=\"mailto:lionel.bacon@uss.salvationarmy.org\" class=\"btn btn-secondary gap-1 mt-2\">Interested? Email Us.</a></p>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>\n\n<p>\n\t \n</p></div>",
								"description": "Text with HTML references.",
