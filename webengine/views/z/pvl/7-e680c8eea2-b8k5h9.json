											"content:textarea:24:55": {
												"icon": "align-justify",
												"name": "Paragraph",
												"type": "textarea",
												"html": "<p>\n\t\t\t\t\tWe believe every child should experience summer camp—exploring nature, learning new skills, developing confidence, and building life-long friendships in a fun and nurturing environment. That’s Why we offer kids from across Alabama, Louisiana, and Mississippi to experience one or more summer camp programs at Camp Hidden Lake, our 300-acre camp in Lexington, Mississippi.\n\t\t\t\t</p>",
												"description": "Mixed Plain and Rich Text",
												"draggable": true,
												"content": "We believe every child should experience summer camp—exploring nature, learning new skills, developing confidence, and building life-long friendships in a fun and nurturing environment. That’s Why we offer kids from across Alabama, Louisiana, and Mississippi to experience one or more summer camp programs at Camp Hidden Lake, our 300-acre camp in Lexington, Mississippi.",
												"position": 2,
												"fullName": "content:textarea:24:55",
