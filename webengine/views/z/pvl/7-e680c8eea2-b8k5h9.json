											"content:textarea:23:73": {
												"icon": "align-justify",
												"name": "Paragraph",
												"type": "textarea",
												"html": "<p>\n\t\t\t\t\tMany children leave school each spring and head out for a fun-filled summer of camps. However, for many kids from income-limited homes, the possibility of going to summer camp is not an option.&nbsp;\n\t\t\t\t</p>",
												"description": "Mixed Plain and Rich Text",
												"draggable": true,
												"content": "Many children leave school each spring and head out for a fun-filled summer of camps. However, for many kids from income-limited homes, the possibility of going to summer camp is not an option.&nbsp;",
												"position": 1,
												"fullName": "content:textarea:23:73",
