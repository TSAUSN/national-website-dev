											},
											"content:textarea:25:92": {
												"icon": "align-justify",
												"name": "Paragraph",
												"type": "textarea",
												"html": "<p>\n\t\t\t\t\tCamp Hidden Lake is residential for a week (6 days), and transportation is provided. During the week, campers experience long, hot summer days, dips in the pool, star-filled nights, campfires, roasted marshmallows, pillow fights, cabin devotions, emblem work, seeing old friends, and making new ones.\n\t\t\t\t</p>",
												"description": "Mixed Plain and Rich Text",
