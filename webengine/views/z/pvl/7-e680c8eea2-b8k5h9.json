							"content:wysiwyg_basic:16:62": {
								"icon": "outdent",
								"name": "WYSIWYG",
								"type": "wysiwyg_basic",
								"html": "<div style=\"position:relative;overflow:hidden;min-height:300px;background-image:url('https://s3.amazonaws.com/uss-cache.salvationarmy.org/d66aa8be-9105-4e58-b95b-3484d0e03f67_Blue+BG.png');background-position:center center;background-repeat:no-repeat;background-size:cover;\" class=\"text-white rounded p-6 gap-3 my-5\">\n            <div style=\"position:absolute;inset:0;z-index:2;\"></div>\n            <div style=\"position:relative;z-index:3;display:flex;align-items:center;justify-content:flex-start;min-height:300px;\">\n                <div style=\"width:100%;padding:40px;color:#ffffff;\">\n                    <div class=\"btgrid\">\n\t<div class=\"row row-1\">\n\t\t<div class=\"col col-md-4 col-sm-12\">\n\t\t\t<div class=\"content\">\n\t\t\t\t<p style=\"text-align:center;color:#fff;\">\n\t\t\t\t\t<img class=\"img-fluid rounded d-block mx-auto\" src=\"https://s3.amazonaws.com/uss-cache.salvationarmy.org/dba27240-d9c5-494a-ba66-de8d276e7e17_The%2BAdventure%2BCorps%2Bphoto.jpg\" style=\"display:block;margin-left:auto;margin-right:auto;\">\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"col col-md-8 col-sm-12\">\n\t\t\t<div class=\"content\">\n\t\t\t\t<h5 style=\"text-align:center;\">The Adventure Corps</h5>\n\n\t\t\t\t<p style=\"text-align:center;color:#fff;\">\n\t\t\t\t\tIs a character-building program designed for boys in grades 1-8. Adventure Corps is a faith-based community program focusing on the physical, mental, and spiritual growth needed in males today. Adventure Corps is an important aspect of Corps ministry that could provide a Corps with a strong young male church base.&nbsp;\n\t\t\t\t</p>\n\n\t\t\t\t<p style=\"text-align:center;color:#fff;\">\n\t\t\t\t\t<strong>To learn more about our scouting and youth ministry programs,</strong>\n\t\t\t\t</p>\n\n\t\t\t\t<p style=\"text-align:center;color:#fff;\">\n\t\t\t\t\tCall <a href=\"tel:+12253554483\" target=\"\">225-355-4483</a> x.401\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>\n                </div>\n            </div>\n        </div>",
								"description": "Text with HTML references.",
								"draggable": true,
								"content": "<div class=\"text-white rounded p-6 gap-3 my-5\" style=\"position:relative;overflow:hidden;min-height:300px;background-image:url('https://s3.amazonaws.com/uss-cache.salvationarmy.org/d66aa8be-9105-4e58-b95b-3484d0e03f67_Blue+BG.png');background-position:center center;background-repeat:no-repeat;background-size:cover;\">\n            <div style=\"position:absolute;inset:0;z-index:2;\"></div>\n            <div style=\"position:relative;z-index:3;display:flex;align-items:center;justify-content:flex-start;min-height:300px;\">\n                <div style=\"width:100%;padding:40px;color:#ffffff;\">\n                    <div class=\"btgrid\">\n\t<div class=\"row row-1\">\n\t\t<div class=\"col col-md-4 col-sm-12\">\n\t\t\t<div class=\"content\">\n\t\t\t\t<p style=\"text-align:center;color:#fff;\">\n\t\t\t\t\t<img class=\"img-fluid rounded d-block mx-auto\" src=\"https://s3.amazonaws.com/uss-cache.salvationarmy.org/dba27240-d9c5-494a-ba66-de8d276e7e17_The%2BAdventure%2BCorps%2Bphoto.jpg\" style=\"display:block;margin-left:auto;margin-right:auto;\">\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"col col-md-8 col-sm-12\">\n\t\t\t<div class=\"content\">\n\t\t\t\t<h5 style=\"text-align:center;\">The Adventure Corps</h5>\n\n\t\t\t\t<p style=\"text-align:center;color:#fff;\">\n\t\t\t\t\tIs a character-building program designed for boys in grades 1-8. Adventure Corps is a faith-based community program focusing on the physical, mental, and spiritual growth needed in males today. Adventure Corps is an important aspect of Corps ministry that could provide a Corps with a strong young male church base.&nbsp;\n\t\t\t\t</p>\n\n\t\t\t\t<p style=\"text-align:center;color:#fff;\">\n\t\t\t\t\t<strong>To learn more about our scouting and youth ministry programs,</strong>\n\t\t\t\t</p>\n\n\t\t\t\t<p style=\"text-align:center;color:#fff;\">\n\t\t\t\t\tCall <a href=\"tel:+12253554483\" target=\"\">225-355-4483</a> x.401\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t</div>\n\t<