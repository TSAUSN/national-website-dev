							"content:textarea:9:38": {
								"icon": "align-justify",
								"name": "Paragraph",
								"type": "textarea",
								"html": "<p>\n\tCharity trends in the US for 2025 show&nbsp;continued growth in total giving to a record $592.50 billion in 2024, driven by strong individual and corporate giving and a booming stock market.&nbsp;However, underlying challenges include declining individual donor retention and increased need, leading to a greater focus on donor retention, personalized experiences, and diversified fundraising streams, including&nbsp;subscription giving&nbsp;and collective giving.&nbsp;Technology, particularly&nbsp;artificial intelligence,&nbsp;is increasingly used for data-driven management and personalized donor journeys, while there is a broader shift towards&nbsp;trust-based philanthropy&nbsp;and long-term impact.&nbsp;\n</p>",
								"description": "Mixed Plain and Rich Text",
								"draggable": true,
								"content": "Charity trends in the US for 2025 show&nbsp;continued growth in total giving to a record $592.50 billion in 2024, driven by strong individual and corporate giving and a booming stock market.&nbsp;However, underlying challenges include declining individual donor retention and increased need, leading to a greater focus on donor retention, personalized experiences, and diversified fundraising streams, including&nbsp;subscription giving&nbsp;and collective giving.&nbsp;Technology, particularly&nbsp;artificial intelligence,&nbsp;is increasingly used for data-driven management and personalized donor journeys, while there is a broader shift towards&nbsp;trust-based philanthropy&nbsp;and long-term impact.&nbsp;",
								"position": 8,
								"fullName": "content:textarea:9:38",
