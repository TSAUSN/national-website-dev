			"content:text:15:24": {
				"icon": "text-height",
				"name": "Heading",
				"type": "text",
				"html": "<h5>Onsite and Year-Round Visibility</h5>",
				"description": "Plain Text",
				"draggable": true,
				"content": "Onsite and Year-Round Visibility",
				"position": 11,
