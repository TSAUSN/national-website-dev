							"content:textarea:13:66": {
								"icon": "align-justify",
								"name": "Paragraph",
								"type": "textarea",
								"html": "<p>Camp Walter Johnson&nbsp;is one of the best places a kid can go. From swimming in a lake to jumping&nbsp;off a boat, exploring the outdoors, and so many more activities. I have been going to Camp Walter Johnson&nbsp;as long as I can remember and honestly, the best part is not the activities, it's the people that you meet.</p>",
								"description": "Mixed Plain and Rich Text",
								"draggable": true,
								"content": "Camp Walter Johnson&nbsp;is one of the best places a kid can go. From swimming in a lake to jumping&nbsp;off a boat, exploring the outdoors, and so many more activities. I have been going to Camp Walter Johnson&nbsp;as long as I can remember and honestly, the best part is not the activities, it's the people that you meet.",
								"position": 12,
								"fullName": "content:textarea:13:66",
								"htmlElement": "p",
								"primarytype": "content",
								"id": "content:textarea:13:66",
