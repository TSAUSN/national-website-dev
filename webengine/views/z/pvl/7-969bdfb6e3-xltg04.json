							"content:textarea:14:54": {
								"icon": "align-justify",
								"name": "Paragraph",
								"type": "textarea",
								"html": "<p>\n\t<em>Every year I learn something new. This year I realized you don't always need to be doing something \"fun\" to have a good time. Like my grandma always says, \"live in the moment\". To me that means no matter what you're doing, find a way to enjoy it.</em>\n</p>",
								"description": "Mixed Plain and Rich Text",
								"draggable": true,
								"content": "Every year I learn something new. This year I realized you don't always need to be doing something \"fun\" to have a good time. Like my grandma always says, \"live in the moment\". To me that means no matter what you're doing, find a way to enjoy it.",
								"position": 13,
								"fullName": "content:textarea:14:54",
								"htmlElement": "p",
								"primarytype": "content",
								"id": "content:textarea:14:54",
								"styles": {
									"fontStyle": "italic"
								},
								"newLoc": "design:columns:1 Column:23:24-1:1 Column:0",
								"oldLoc": "bank",
