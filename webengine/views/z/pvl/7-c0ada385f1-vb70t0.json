							"content:wysiwyg_basic:3:2": {
								"icon": "outdent",
								"name": "WYSIWYG",
								"type": "wysiwyg_basic",
								"html": "<div style=\"position:relative;overflow:hidden;min-height:300px;background-image:url('https://s3.amazonaws.com/uss-cache.salvationarmy.org/0848a12b-c18a-464f-949d-80479b708809_Blue+BG.png');background-position:center center;background-repeat:no-repeat;background-size:cover;\" class=\"text-white rounded p-6 gap-3 my-5\">\n            <div style=\"position:absolute;inset:0;z-index:2;\"></div>\n            <div style=\"position:relative;z-index:3;display:flex;align-items:center;justify-content:flex-start;min-height:300px;\">\n                <div style=\"width:100%;padding:40px;color:#ffffff;\">\n                    <p style=\"text-align:center;color:#fff;\">\n\tMeetings are held on the\n</p>\n\n<h5 style=\"text-align:center;\">Second Wednesday of Each Month</h5>\n\n<p style=\"text-align:center;color:#fff;\">\n\tAt our Community Worship Center (570 Beasley Rd.)&nbsp;at 11:30am<br>\n\tFor lunch followed by our membership meeting from 12pm-1pm.\n</p>\n\n<p style=\"text-align:center;color:#fff;\">\n\tWe would love to have you!\n</p>\n\n<p style=\"text-align:center;color:#fff;\">\n\t<em><strong>To get more involved in our community, consider joining our Women's Auxiliary.</strong></em>\n</p>\n                </div>\n            </div>\n        </div>",
								"description": "Text with HTML references.",
								"draggable": true,
								"content": "<div class=\"text-white rounded p-6 gap-3 my-5\" style=\"position:relative;overflow:hidden;min-height:300px;background-image:url('https://s3.amazonaws.com/uss-cache.salvationarmy.org/0848a12b-c18a-464f-949d-80479b708809_Blue+BG.png');background-position:center center;background-repeat:no-repeat;background-size:cover;\">\n            <div style=\"position:absolute;inset:0;z-index:2;\"></div>\n            <div style=\"position:relative;z-index:3;display:flex;align-items:center;justify-content:flex-start;min-height:300px;\">\n                <div style=\"width:100%;padding:40px;color:#ffffff;\">\n                    <p style=\"text-align:center;color:#fff;\">\n\tMeetings are held on the\n</p>\n\n<h5 style=\"text-align:center;\">Second Wednesday of Each Month</h5>\n\n<p style=\"text-align:center;color:#fff;\">\n\tAt our Community Worship Center (570 Beasley Rd.)&nbsp;at 11:30am<br>\n\tFor lunch followed by our membership meeting from 12pm-1pm.\n</p>\n\n<p style=\"text-align:center;color:#fff;\">\n\tWe would love to have you!\n</p>\n\n<p style=\"text-align:center;color:#fff;\">\n\t<em><strong>To get more involved in our community, consider joining our Women's Auxiliary.</strong></em>\n</p>\n                </div>\n            </div>\n        </div>",
