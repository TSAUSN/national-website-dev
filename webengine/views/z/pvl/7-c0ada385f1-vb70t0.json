							"content:wysiwyg_basic:7:35": {
								"icon": "outdent",
								"name": "WYSIWYG",
								"type": "wysiwyg_basic",
								"html": "<ul>\n\t<li><strong>Active Member - $30</strong>\n<ul>\n\t\t<li>I wish to attend and participate in meetings, activities, and projects and volunteer a minimum 25 hours.</li>\n\t</ul>\n\t</li>\n\t<li><strong>Supporting Member - $50</strong><ul>\n\t\t<li>I am unable to attend meetings but will lend a hand on projects as I am able.</li>\n\t</ul>\n\t</li>\n\t<li><strong>CONTRIBUTING&nbsp;MEMBER&nbsp;- $100</strong><ul>\n\t\t<li>I will give financial support and attend meetings as I am able.</li>\n\t</ul>\n\t</li>\n\t<li><strong>Sponsoring Member - $250</strong><ul>\n\t\t<li>I will give financial support for special projects only. I wish to be kept informed of events through newsletters and minutes.</li>\n\t</ul>\n\t</li>\n</ul>",
								"description": "Text with HTML references.",
								"draggable": true,
								"content": "<ul>\n\t<li><strong>Active Member - $30</strong>\n<ul>\n\t\t<li>I wish to attend and participate in meetings, activities, and projects and volunteer a minimum 25 hours.</li>\n\t</ul>\n\t</li>\n\t<li><strong>Supporting Member - $50</strong><ul>\n\t\t<li>I am unable to attend meetings but will lend a hand on projects as I am able.</li>\n\t</ul>\n\t</li>\n\t<li><strong>CONTRIBUTING&nbsp;MEMBER&nbsp;- $100</strong><ul>\n\t\t<li>I will give financial support and attend meetings as I am able.</li>\n\t</ul>\n\t</li>\n\t<li><strong>Sponsoring Member - $250</strong><ul>\n\t\t<li>I will give financial support for special projects only. I wish to be kept informed of events through newsletters and minutes.</li>\n\t</ul>\n\t</li>\n</ul>",
