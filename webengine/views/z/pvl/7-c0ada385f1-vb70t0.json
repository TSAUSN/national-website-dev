							"content:textarea:1:74": {
								"icon": "align-justify",
								"name": "Paragraph",
								"type": "textarea",
								"html": "<p>\n\tThe Salvation Army Women's Auxiliary groups have been around for decades. These women have served with the \"Heart to God, Hand to Man\" philosophy of the worldwide Salvation Army. Serving as a fund-raising and volunteer service group, the women of the Auxiliary have impacted the lives of people in need of services provided by The Salvation Army&nbsp;throughout&nbsp;Hinds, Madison, Rankin, Scott, Yazoo and Copiah counties.&nbsp;\n</p>",
								"description": "Mixed Plain and Rich Text",
								"draggable": true,
								"content": "The Salvation Army Women's Auxiliary groups have been around for decades. These women have served with the \"Heart to God, Hand to Man\" philosophy of the worldwide Salvation Army. Serving as a fund-raising and volunteer service group, the women of the Auxiliary have impacted the lives of people in need of services provided by The Salvation Army&nbsp;throughout&nbsp;Hinds, Madison, Rankin, Scott, Yazoo and Copiah counties.&nbsp;",
