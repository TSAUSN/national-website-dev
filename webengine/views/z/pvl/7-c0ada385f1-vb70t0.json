							"content:textarea:2:15": {
								"icon": "align-justify",
								"name": "Paragraph",
								"type": "textarea",
								"html": "<p>\n\tThe Salvation Army Women's Auxiliary's membership is always open. We exist for the sole purpose of helping others. Serving others&nbsp;is the core of every project we support and promote. Our mission is to be “the Army Behind the Army” helping The Salvation Army meet the need of others.\n</p>",
