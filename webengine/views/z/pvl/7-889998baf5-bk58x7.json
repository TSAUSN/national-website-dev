			"content:textarea:8:10": {
				"icon": "align-justify",
				"name": "Paragraph",
				"type": "textarea",
				"html": "<p>\n\tThe purpose of The Salvation Army Metro Atlanta Red Shield Services Emergency and Transitional Housing Facility (Red Shield Shelter) is to provide strategic intervention, refuge and safe lodging for homeless men, women and families with children in crisis. Our focus is to provide emergency, transitional and recovery programs that empower people of all ages to begin their transition to stable independence; by discovering and overcoming the root causes of their homelessness.\n</p>",
				"description": "Mixed Plain and Rich Text",
				"draggable": true,
				"content": "The purpose of The Salvation Army Metro Atlanta Red Shield Services Emergency and Transitional Housing Facility (Red Shield Shelter) is to provide strategic intervention, refuge and safe lodging for homeless men, women and families with children in crisis. Our focus is to provide emergency, transitional and recovery programs that empower people of all ages to begin their transition to stable independence; by discovering and overcoming the root causes of their homelessness.",
				"position": 8,
				"fullName": "content:textarea:8:10",
				"htmlElement": "p",
				"primarytype": "content",
				"id": "content:textarea:8:10",
