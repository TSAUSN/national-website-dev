				"name": "Paragraph",
				"type": "textarea",
				"html": "<p>\n\t<span style=\"color:#ed1c2b;\">Veterans on the Move:</span>&nbsp;Applicants can stay up to two years and must be referred through the Veterans Administration Homeless Program.\n</p>",
				"description": "Mixed Plain and Rich Text",
