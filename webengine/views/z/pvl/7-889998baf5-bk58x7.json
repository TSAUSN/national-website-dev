			"content:textarea:14:71": {
				"icon": "align-justify",
				"name": "Paragraph",
				"type": "textarea",
				"html": "<p>\n\t<span style=\"color:#ed1c2b;\">Cold Weather Program:&nbsp;</span>When the weather is below 40 degrees and if the applicant is not intoxicated.\n</p>",
				"description": "Mixed Plain and Rich Text",
				"draggable": true,
				"content": "Cold Weather Program:&nbsp;When the weather is below 40 degrees and if the applicant is not intoxicated.",
				"position": 13,
				"fullName": "content:textarea:14:71",
				"htmlElement": "p",
				"primarytype": "content",
				"id": "content:textarea:14:71",
