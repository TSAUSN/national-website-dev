				"contentOverride": false
			},
			"content:textarea:15:2": {
				"icon": "align-justify",
				"name": "Paragraph",
				"type": "textarea",
				"html": "<p>\n\t<span style=\"color:#ed1c2b;\">Emergency Assessment Program:&nbsp;</span>Individual applicants can access this program for a 30 day stay, once in a twelve-month period. Applicants must be homeless and need to present a valid form of identification.\n</p>",
				"description": "Mixed Plain and Rich Text",
				"draggable": true,
				"content": "Emergency Assessment Program:&nbsp;Individual applicants can access this program for a 30 day stay, once in a twelve-month period. Applicants must be homeless and need to present a valid form of identification.",
				"position": 14,
				"fullName": "content:textarea:15:2",
				"htmlElement": "p",
				"primarytype": "content",
				"id": "content:textarea:15:2",
				"styles": {
					"color": "#ed1c2b"
				},
				"newLoc": "layout:root:column:0",
				"oldLoc": "bank",
				"contentOverride": false
			},
			"content:textarea:16:24": {
				"icon": "align-justify",
				"name": "Paragraph",
				"type": "textarea",
				"html": "<p>\n\t<span style=\"color:#ed1c2b;\">Family Emergency Program:&nbsp;</span>Applicants must be the head of household with documented proof of custody of children. Applicants can stay up to 60 days, once in a twelve-month period. Applicants must present a valid form of identification.\n</p>",
				"description": "Mixed Plain and Rich Text",
				"draggable": true,
				"content": "Family Emergency Program:&nbsp;Applicants must be the head of household with documented proof of custody of children. Applicants can stay up to 60 days, once in a twelve-month period. Applicants must present a valid form of identification.",
				"position": 15,
				"fullName": "content:textarea:16:24",
				"htmlElement": "p",
				"primarytype": "content",
				"id": "content:textarea:16:24",
				"styles": {
					"color": "#ed1c2b"
				},
				"newLoc": "layout:root:column:0",
				"oldLoc": "bank",
				"contentOverride": false
			},
			"content:textarea:17:55": {
				"icon": "align-justify",
				"name": "Paragraph",
				"type": "textarea",
				"html": "<p>\n\t<span style=\"color:#ed1c2b;\">Supportive Emergency Program:&nbsp;</span>Applicants can stay up to 90 days, must be homeless, need to present two forms of identification, and must have an income or sponsorship.\n</p>",
				"description": "Mixed Plain and Rich Text",
				"draggable": true,
				"content": "Supportive Emergency Program:&nbsp;Applicants can stay up to 90 days, must be homeless, need to present two forms of identification, and must have an income or sponsorship.",
				"position": 16,
				"fullName": "content:textarea:17:55",
				"htmlElement": "p",
				"primarytype": "content",
				"id": "content:textarea:17:55",
				"styles": {
					"color": "#ed1c2b"
				},
				"newLoc": "layout:root:column:0",
				"oldLoc": "bank",
				"contentOverride": false
			},
			"content:textarea:18:43": {
				"icon": "align-justify",
				"name": "Paragraph",
				"type": "textarea",
				"html": "<p>\n\t<span style=\"color:#ed1c2b;\">Re-entry Program:</span>&nbsp;Applicants can stay up to three months and must be referred by the State Board of Pardons and the Paroles Housing Coordinator.\n</p>",
				"description": "Mixed Plain and Rich Text",
				"draggable": true,
				"content": "Re-entry Program:&nbsp;Applicants can stay up to three months and must be referred by the State Board of Pardons and the Paroles Housing Coordinator.",
				"position": 17,
				"fullName": "content:textarea:18:43",
				"htmlElement": "p",
				"primarytype": "content",
				"id": "content:textarea:18:43",
				"styles": {
					"color": "#ed1c2b"
				},
				"newLoc": "layout:root:column:0",
				"oldLoc": "bank",
				"contentOverride": false
			},
			"content:textarea:19:96": {
				"icon": "align-justify",
				"name": "Paragraph",
				"type": "textarea",
				"html": "<p>\n\t<span style=\"color:#ed1c2b;\">Harbor Light Drug Treatment:</span>&nbsp;Applicants are entered into a 90-day program, must be homeless or referred through U.S. District Courts, must have qualifying medical paperwork prior to entry (call for details) and must complete a screening interview prior to entry. Most beds are fee-based, some are free or sponsored.\n</p>",
				"description": "Mixed Plain and Rich Text",
				"draggable": true,
				"content": "Harbor Light Drug Treatment:&nbsp;Applicants are entered into a 90-day program, must be homeless or referred through U.S. District Courts, must have qualifying medical paperwork prior to entry (call for details) and must complete a screening interview prior to entry. Most beds are fee-based, some are free or sponsored.",
				"position": 18,
				"fullName": "content:textarea:19:96",
				"htmlElement": "p",
				"primarytype": "content",
				"id": "content:textarea:19:96",
				"styles": {
					"color": "#ed1c2b"
				},
				"newLoc": "layout:root:column:0",
				"oldLoc": "bank",
				"contentOverride": false
			},
			"content:textarea:20:77": {
				"icon": "align-justify",
				"name": "Paragraph",
				"type": "textarea",
				"html": "<p>\n\t<span style=\"color:#ed1c2b;\">Rapid Rehousing Programs:</span>&nbsp;Rapid Rehousing programs are designed to provide services to those who are in need of obtaining permanent housing or maintaining current housing. These services include financial assistance and a referral to the Furniture Bank (if needed), determined on a case by case basis. The Home Again program provides assistance to families that are categorized as either homeless, at risk of becoming homeless or are at imminent risk of losing their current housing.&nbsp; The Housing Stability program provides assistance to singles that are currently residing within The Salvation Army Red Shield Services on a referral basis. The DeKalb Rehousing program provides assistance after a coordinated assessment with security and utility deposits.\n</p>",
				"description": "Mixed Plain and Rich Text",
				"draggable": true,
				"content": "Rapid Rehousing Programs:&nbsp;Rapid Rehousing programs are designed to provide services to those who are in need of obtaining permanent housing or maintaining current housing. These services include financial assistance and a referral to the Furniture Bank (if needed), determined on a case by case basis. The Home Again program provides assistance to families that are categorized as either homeless, at risk of becoming homeless or are at imminent risk of losing their current housing.&nbsp; The Housing Stability program provides assistance to singles that are currently residing within The Salvation Army Red Shield Services on a referral basis. The DeKalb Rehousing program provides assistance after a coordinated assessment with security and utility deposits.",
				"position": 19,
				"fullName": "content:textarea:20:77",
				"htmlElement": "p",
				"primarytype": "content",
				"id": "content:textarea:20:77",
				"styles": {
					"color": "#ed1c2b"
				},
				"newLoc": "layout:root:column:0",
				"oldLoc": "bank",
				"contentOverride": false
			},
			"content:textarea:21:87": {
				"icon": "align-justify",
				"name": "Paragraph",
				"type": "textarea",
				"html": "<p>\n\t<span style=\"color:#ed1c2b;\">S</span><span style=\"color:#ed1c2b;\">upportive Emergency Family Program:</span>&nbsp;Applicants must be the head of household with documented proof of custody of children. Families can stay up to 90 days and must have income or sponsorship.\n</p>",
				"description": "Mixed Plain and Rich Text",
				"draggable": true,
				"content": "Supportive Emergency Family Program:&nbsp;Applicants must be the head of household with documented proof of custody of children. Families can stay up to 90 days and must have income or sponsorship.",
				"position": 20,
