			"content:textarea:13:71": {
				"icon": "align-justify",
				"name": "Paragraph",
				"type": "textarea",
				"html": "<p>\n\t<span style=\"color:#ed1c2b;\"><strong>HOUSING PROGRAMS PROVIDED:</strong></span>\n</p>",
				"description": "Mixed Plain and Rich Text",
