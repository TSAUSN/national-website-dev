							"content:textarea:2:21": {
								"icon": "align-justify",
								"name": "Paragraph",
								"type": "textarea",
								"html": "<p>\n\tWelcome to The Salvation Army Sapulpa Women's Auxiliary! We are a group of compassionate women united in our commitment to serve the Creek County community. Through fundraising and volunteer efforts, we support The Salvation Army's mission to address local social issues and uplift those in need. Join us in this fulfilling journey as we form lasting friendships, make a positive impact, and create a stronger, more compassionate community.\n</p>",
								"description": "Mixed Plain and Rich Text",
								"draggable": true,
								"content": "Welcome to The Salvation Army Sapulpa Women's Auxiliary! We are a group of compassionate women united in our commitment to serve the Creek County community. Through fundraising and volunteer efforts, we support The Salvation Army's mission to address local social issues and uplift those in need. Join us in this fulfilling journey as we form lasting friendships, make a positive impact, and create a stronger, more compassionate community.",
								"position": 1,
								"fullName": "content:textarea:2:21",
