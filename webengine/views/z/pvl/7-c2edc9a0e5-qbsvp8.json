							"content:textarea:3:71": {
								"icon": "align-justify",
								"name": "Paragraph",
								"type": "textarea",
								"html": "<p>\n\tOur auxiliary is a vibrant fundraising and volunteer service group that works tirelessly to support The Salvation Army's initiatives. By organizing charity events, coordinating donation drives, and generating essential resources, we contribute to the financial support needed to expand outreach programs and extend services to individuals and families in need. Together, we make a difference in the lives of others and build a better future for our community.\n</p>",
								"description": "Mixed Plain and Rich Text",
								"draggable": true,
								"content": "Our auxiliary is a vibrant fundraising and volunteer service group that works tirelessly to support The Salvation Army's initiatives. By organizing charity events, coordinating donation drives, and generating essential resources, we contribute to the financial support needed to expand outreach programs and extend services to individuals and families in need. Together, we make a difference in the lives of others and build a better future for our community.",
								"position": 2,
								"fullName": "content:textarea:3:71",
								"htmlElement": "p",
								"primarytype": "content",
								"id": "content:textarea:3:71",
