			"content:textarea:11:15": {
				"icon": "align-justify",
				"name": "Paragraph",
				"type": "textarea",
				"html": "<p>\n\tOur state-of-the-art swimming pool provides a year-round opportunity for community members to be physically active. Swimming lessons are offered in order reduce risk of injury and create strong swimmers living in the river city.\n</p>",
