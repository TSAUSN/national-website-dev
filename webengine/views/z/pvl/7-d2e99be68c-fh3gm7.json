			"content:textarea:7:52": {
				"icon": "align-justify",
				"name": "Paragraph",
				"type": "textarea",
				"html": "<p>\n\tBon Secours Richmond Health System, in addition to underwriting Oasis Wellness Center programming, was the largest corporate contributor to The Salvation Army’s multimillion-dollar renovation of the 48-year old Youth Ministry Program building, completed in April 2019, where Oasis Wellness Center is housed.\n</p>",
				"description": "Mixed Plain and Rich Text",
				"draggable": true,
				"content": "Bon Secours Richmond Health System, in addition to underwriting Oasis Wellness Center programming, was the largest corporate contributor to The Salvation Army’s multimillion-dollar renovation of the 48-year old Youth Ministry Program building, completed in April 2019, where Oasis Wellness Center is housed.",
