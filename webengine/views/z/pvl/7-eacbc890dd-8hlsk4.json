							"content:text:3:22": {
								"icon": "text-height",
								"name": "Heading",
								"type": "text",
								"html": "<h5>How we help provide housing</h5>",
								"description": "Plain Text",
								"draggable": true,
								"content": "How we help provide housing",
								"position": 2,
								"fullName": "content:text:3:22",
