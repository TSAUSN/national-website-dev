							"content:textarea:5:47": {
								"icon": "align-justify",
								"name": "Paragraph",
								"type": "textarea",
								"html": "<p>\n\tOn-site Case workers develop, in cooperation with clients, an extensive goal-oriented program. Case workers continually motivate clients to meet these goals.\n</p>",
								"description": "Mixed Plain and Rich Text",
								"draggable": true,
								"content": "On-site Case workers develop, in cooperation with clients, an extensive goal-oriented program. Case workers continually motivate clients to meet these goals.",
