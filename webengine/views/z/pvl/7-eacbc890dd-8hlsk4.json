							"content:textarea:4:96": {
								"icon": "align-justify",
								"name": "Paragraph",
								"type": "textarea",
								"html": "<p>\n\tDuring a stay at a Salvation Army shelter, clients will participate in programs and workshops developed to promote self-sufficiency and personal development. The Salvation Army also works with clients to help them transition into a more permanent housing situation.\n</p>",
								"description": "Mixed Plain and Rich Text",
								"draggable": true,
								"content": "During a stay at a Salvation Army shelter, clients will participate in programs and workshops developed to promote self-sufficiency and personal development. The Salvation Army also works with clients to help them transition into a more permanent housing situation.",
								"position": 3,
								"fullName": "content:textarea:4:96",
