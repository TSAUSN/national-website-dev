								"icon": "align-justify",
								"name": "Paragraph",
								"type": "textarea",
								"html": "<p><span>This holiday season, give the gift of your time by volunteering as a <span style=\"color:#ed1c2b;\">Salvation Army Red Kettle Bell Ringer!</span> </span></p>",
