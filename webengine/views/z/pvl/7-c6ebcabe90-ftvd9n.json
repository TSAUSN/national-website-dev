								"type": "wysiwyg_basic",
								"html": "<div style=\"color:#111111;\" class=\"rounded p-6 gap-3 mt-3 bg-light text-dark\">\n<div class=\"btgrid\">\n\t<div class=\"row row-1\">\n\t\t<div class=\"col col-md-6\">\n\t\t\t<div class=\"content\">\n\t\t\t\t<p>\n\t\t\t\t\t \n\t\t\t\t</p>\n\n\t\t\t\t<h5>MEDIA CONTACTS</h5>\n\n\t\t\t\t<p>\n\t\t\t\t\tFollowing is a media relations contact list for The Salvation Army in Florida. State media relations are handled by Florida Divisional Headquarters. All local media are asked to first contact their local Salvation Army representative for requests for spokespersons and other inquiries.\n\t\t\t\t</p>\n\n\t\t\t\t<p>\n\t\t\t\t\t \n\t\t\t\t</p>\n\n\t\t\t\t<div class=\"row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3\"><div class=\"col\"><div class=\"card h-100 border\"><div class=\"card-body\"><h5 class=\"card-title text-primary-emphasis\">Divisional Headquarters:</h5><p class=\"card-text\">Divisional Communications Director <br>\n\t\t\t\t\t\t\t\t<a href=\"tel:8133835668\">813.383.5668</a></p><a href=\"https://salvationarmyflorida.org\" class=\"btn btn-secondary gap-1 mt-2 btn-sm\">Website</a></div></div></div></div>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"col col-md-6\">\n\t\t\t<div class=\"content\">\n\t\t\t\t\n\t\t\t\t\n\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>\n\n<p>\n\t \n</p>\n\n<p>\n\t\n</p>\n\n<div class=\"row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3\"><div class=\"col\"><div class=\"card h-100 border\"><div class=\"card-body\"><h5 class=\"card-title text-primary-emphasis\">PENSACOLA:</h5><p class=\"card-text\">Captain Stephan Wildish <a href=\"mailto:Stephan.Wildish@uss.salvationarmy.org\">Stephan.Wildish@uss.salvationarmy.org</a><br>\n\t\t\t\t<a href=\"tel:4079734628\">407-973-4628</a></p><a href=\"https://pensacola.salvationarmyflorida.org/\" class=\"btn btn-secondary gap-1 mt-2 btn-sm\">Website</a></div></div></div><div class=\"col\"><div class=\"card h-100 border\"><div class=\"card-body\"><h5 class=\"card-title text-primary-emphasis\">PANAMA CITY:</h5><p class=\"card-text\">Captain Arnaldo Pena <a href=\"mailto:arnaldo.pena@uss.salvationarmy.org\">arnaldo.pena@uss.salvationarmy.org</a><br>\n\t\t\t\t<a href=\"tel:8507695359\">850-769-5359</a></p><a href=\"https://panamacity.salvationarmyflorida.org/\" class=\"btn btn-secondary gap-1 mt-2 btn-sm\">Website</a></div></div></div><div class=\"col\"><div class=\"card h-100 border\"><div class=\"card-body\"><h5 class=\"card-title text-primary-emphasis\">TALLAHASSEE:</h5><p class=\"card-text\">Jeremy Bridges <a href=\"mailto:Jeremy.Bridges@uss.salvationarmy.org\">Jeremy.Bridges@uss.salvationarmy.org</a> <a href=\"tel:8502220304\">850-222-0304</a></p><a href=\"https://TALLAHASSEE.salvationarmyflorida.org/\" class=\"btn btn-secondary gap-1 mt-2 btn-sm\">Website</a></div></div></div><div class=\"col\"><div class=\"card h-100 border\"><div class=\"card-body\"><h5 class=\"card-title text-primary-emphasis\">GAINESVILLE:</h5><p class=\"card-text\">Major Ernest Hull <a href=\"mailto:ernest.hull@uss.salvationarmy.org\">ernest.hull@uss.salvationarmy.org</a> <a href=\"tel:3523761743\">352-376-1743</a></p><a href=\"https://gainesville.salvationarmyflorida.org/\" class=\"btn btn-secondary gap-1 mt-2 btn-sm\">Website</a></div></div></div><div class=\"col\"><div class=\"card h-100 border\"><div class=\"card-body\"><h5 class=\"card-title text-primary-emphasis\">JACKSONVILLE:</h5><p class=\"card-text\">Lillie Carnes <a href=\"mailto:lillie.carnes@uss.salvationarmy.org\">lillie.carnes@uss.salvationarmy.org</a><br>\n\t\t\t\t<a href=\"tel:9043014839\">904-301-4839</a></p><a href=\"https://nefl.salvationarmyflorida.org/\" class=\"btn btn-secondary gap-1 mt-2 btn-sm\">Website</a></div></div></div><div class=\"col\"><div class=\"card h-100 border\"><div class=\"card-body\"><h5 class=\"card-title text-primary-emphasis\">ORLANDO:</h5><p class=\"card-text\">Natasha Player <a href=\"mailto:Natasha.Player@uss.salvationarmy.org\">Natasha.Player@uss.salvationarmy.org</a> <a href=\"tel:4073888258\">407-388-8258</a></p><a href=\"https://orlando.salvationarmyflorida.org/\" class=\"btn btn-secondary gap-1 mt-2 btn-sm\">Website</a></div></div></div><div class=\"col\"><div class=\"card h-100 border\"><div class=\"card-body\"><h5 class=\"card-title text-primary-emphasis\">TAMPA:</h5><p class=\"card-text\">Aaron DeWinter <a href=\"mailto:aaron.deWinter@uss.salvationarmy.org\">aaron.deWinter@uss.salvationarmy.org</a><br>\n\t\t\t\t<a href=\"tel:8133744331\">813-374-4331</a></p><a href=\"https://tampa.salvationarmyflorida.org/\" class=\"btn btn-secondary gap-1 mt-2 btn-sm\">Website</a></div></div></div><div class=\"col\"><div class=\"card h-100 border\"><div class=\"card-body\"><h5 class=\"card-title text-primary-emphasis\">FT. MYERS:</h5><p class=\"card-text\">David Asselin <a href=\"mailto:David.Asselin@uss.salvationarmy.org\">David.Asselin@uss.salvationarmy.org</a><br>\n\t\t\t\t<a href=\"tel:2392787725\">239-278-7725</a></p><a href=\"https://fortmyers.salvationarmyflorida.org/\" class=\"btn btn-secondary gap-1 mt-2 btn-sm\">Website</a></div></div></div><div class=\"col\"><div class=\"card h-100 border\"><div class=\"card-body\"><h5 class=\"card-title text-primary-emphasis\">WEST PALM BEACH:</h5><p class=\"card-text\">Major James Hall <a href=\"mailto:James.Hall@uss.salvationarmy.org\">James.Hall@uss.salvationarmy.org</a><br>\n\t\t\t\t<a href=\"tel:5612329143\">561-232-9143</a></p><a href=\"https://palmbeachcounty.salvationarmyflorida.org/\" class=\"btn btn-secondary gap-1 mt-2 btn-sm\">Website</a></div></div></div><div class=\"col\"><div class=\"card h-100 border\"><div class=\"card-body\"><h5 class=\"card-title text-primary-emphasis\">MIAMI:</h5><p class=\"card-text\">Joanne Joseph<br>\n\t\t\t\t<a href=\"mailto:Joanne.Joseph@uss.salvationarmy.org\">Joanne.Joseph@uss.salvationarmy.org</a> <a href=\"tel:3056376700;ext=26644\">305-637-6700 ext. 26644</a></p><a href=\"https://miami.salvationarmyflorida.org/\" class=\"btn btn-secondary gap-1 mt-2 btn-sm\">W